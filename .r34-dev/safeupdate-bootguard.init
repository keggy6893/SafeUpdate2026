#!/bin/sh
### BEGIN INIT INFO
# Provides:          safeupdate-bootguard
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: SafeUpdate2026 post-update boot guard
### END INIT INFO

PIDFILE=/var/run/safeupdate-bootguard.pid
BIN=/usr/bin/safeupdate-bootguard

case "$1" in
    start)
        [ -x "$BIN" ] || exit 0
        if [ -f "$PIDFILE" ]; then
            PID="$(cat "$PIDFILE" 2>/dev/null || true)"
            [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null && exit 0
            rm -f "$PIDFILE"
        fi
        "$BIN" >/tmp/safeupdate-bootguard.log 2>&1 &
        ;;
    stop)
        if [ -f "$PIDFILE" ]; then
            PID="$(cat "$PIDFILE" 2>/dev/null || true)"
            [ -n "$PID" ] && kill "$PID" 2>/dev/null || true
            rm -f "$PIDFILE"
        fi
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
exit 0
