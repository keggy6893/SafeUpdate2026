#!/usr/bin/env python3
# SafeUpdate2026 r34-dev2 recovery helper
# Runs outside Enigma2. Standard library only.

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

STATE_FILE = "/etc/enigma2/safeupdate2026.json"
PLAN_FILE = "/boot/.safeupdate2026-recovery.json"
MOUNTPOINT = "/tmp/safeupdate2026-recovery-root"
NEW_SUFFIX = ".safeupdate-restore-new"
OLD_SUFFIX = ".safeupdate-broken-old"
RESERVE_BYTES = 128 * 1024 * 1024

def die(msg, code=2):
    print("\n[BLOCKIERT] %s" % msg)
    raise SystemExit(code)

def read_text(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    except Exception:
        return ""

def load_json(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}

def write_json_atomic(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    subprocess.call(["sync"])

def cmd_value(key):
    cmd = read_text("/proc/cmdline")
    m = re.search(r"(?:^|\s)%s=([^\s]+)" % re.escape(key), cmd)
    return m.group(1).strip("'\"") if m else ""

def current_slot():
    sub = cmd_value("rootsubdir")
    m = re.search(r"(?:^|/)linuxrootfs(\d+)$", sub)
    if m:
        return int(m.group(1))
    kern = cmd_value("kernel")
    m = re.search(r"(?:^|/)linuxrootfs(\d+)/zImage$", kern)
    return int(m.group(1)) if m else None

def resolve_root_spec(spec):
    spec = (spec or "").strip()
    if spec.startswith("/dev/"):
        return os.path.realpath(spec)
    maps = {
        "UUID=": "/dev/disk/by-uuid/",
        "PARTUUID=": "/dev/disk/by-partuuid/",
        "LABEL=": "/dev/disk/by-label/",
        "PARTLABEL=": "/dev/disk/by-partlabel/",
    }
    for prefix, base in maps.items():
        if spec.startswith(prefix):
            p = os.path.join(base, spec[len(prefix):])
            if os.path.exists(p):
                return os.path.realpath(p)
    try:
        out = subprocess.check_output(
            ["blkid", "-t", spec, "-o", "device"],
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip().splitlines()
        if out:
            return os.path.realpath(out[0])
    except Exception:
        pass
    return ""

def safe_rootsubdir(value, slot):
    value = os.path.normpath((value or "").strip().lstrip("/"))
    if not value or value.startswith("../") or value == "..":
        return ""
    parts = [p for p in value.split("/") if p not in ("", ".")]
    if not parts or any(p == ".." for p in parts):
        return ""
    if parts[-1] != "linuxrootfs%d" % int(slot):
        return ""
    return "/".join(parts)

def parse_startup(slot):
    path = "/boot/STARTUP_%d" % int(slot)
    if not os.path.isfile(path) or os.path.islink(path):
        return None
    text = read_text(path)

    def grab(key):
        m = re.search(r"(?:^|[\s'\"])%s=([^\s'\"]+)" % key, text)
        return m.group(1) if m else ""

    root = grab("root")
    rootsubdir = safe_rootsubdir(grab("rootsubdir"), slot)
    kernel = grab("kernel")
    if not root or not rootsubdir or not kernel:
        return None
    rootdev = resolve_root_spec(root)
    if not rootdev:
        return None

    normkernel = os.path.normpath(kernel.lstrip("/"))
    expected_kernel = os.path.join(rootsubdir, "zImage")
    return {
        "slot": int(slot),
        "path": path,
        "root": root,
        "rootdev": rootdev,
        "rootsubdir": rootsubdir,
        "kernel": kernel,
        "kernel_in_tree": normkernel == expected_kernel,
    }

def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            b = f.read(1024 * 1024)
            if not b:
                break
            h.update(b)
    return h.hexdigest()

def tree_size(path):
    total = 0
    for root, dirs, files in os.walk(path, followlinks=False):
        for name in files:
            p = os.path.join(root, name)
            try:
                if not os.path.islink(p):
                    total += os.lstat(p).st_size
            except OSError:
                pass
    return total

def valid_tree(path, expected_hash=""):
    if not os.path.isdir(path) or os.path.islink(path):
        return False
    required = [
        os.path.join(path, "etc", "image-version"),
        os.path.join(path, "sbin", "init"),
        os.path.join(path, "usr", "bin", "enigma2"),
        os.path.join(path, "zImage"),
    ]
    if not all(os.path.exists(p) for p in required):
        return False
    if expected_hash:
        try:
            if sha256(os.path.join(path, "zImage")) != expected_hash:
                return False
        except Exception:
            return False
    return True

def fs_error_seen(dev):
    base = os.path.basename(os.path.realpath(dev or ""))
    if not base:
        return ""
    try:
        out = subprocess.check_output(["dmesg"], stderr=subprocess.STDOUT, text=True)
    except Exception:
        return ""
    for line in out.splitlines():
        low = line.lower()
        if ("ext4-fs (%s)" % base).lower() in low and any(
            x in low for x in ("error", "abort", "corrupt", "journal")
        ):
            return line.strip()
        if "jbd2:" in low and any(x in low for x in ("invalid checksum", "error", "abort", "corrupt")):
            return line.strip()
    return ""

def mount_root(dev):
    os.makedirs(MOUNTPOINT, exist_ok=True)
    if os.path.ismount(MOUNTPOINT):
        subprocess.check_call(["umount", MOUNTPOINT])
    subprocess.check_call(["mount", "-o", "rw", dev, MOUNTPOINT])
    return MOUNTPOINT

def unmount_root():
    try:
        if os.path.ismount(MOUNTPOINT):
            subprocess.call(["sync"])
            subprocess.call(["umount", MOUNTPOINT])
    except Exception:
        pass

def headline():
    print("=" * 62)
    print("              SAFE UPDATE 2026 - RECOVERY")
    print("                    r34-dev2 TEST")
    print("=" * 62)

def relation_or_die():
    plan = load_json(PLAN_FILE)
    state = load_json(STATE_FILE)

    if plan.get("version") == 2 and plan.get("source_slot") and plan.get("backup_slot"):
        try:
            source = int(plan["source_slot"])
            backup = int(plan["backup_slot"])
        except Exception:
            die("Recovery-Plan enthält ungültige Slotnummern.")
        if source <= 0 or backup <= 0 or source == backup:
            die("Recovery-Plan enthält eine unsichere Slot-Zuordnung.")
        expected_hash = str(plan.get("kernel_sha256") or "")
        return plan, state, source, backup, expected_hash

    if not state.get("verified") or state.get("backup_mode", "slot") != "slot":
        die("Kein verifizierter Slot-Recovery-Plan vorhanden.")
    try:
        source = int(state["source_slot"])
        backup = int(state["target_slot"])
    except Exception:
        die("Backup-Zuordnung source_slot/target_slot fehlt.")
    if source <= 0 or backup <= 0 or source == backup:
        die("Ungültige Slot-Zuordnung.")
    return {}, state, source, backup, str(state.get("kernel_sha256") or "")

def set_startup_once(slot):
    info = parse_startup(slot)
    if not info:
        die("STARTUP_%d konnte nicht sicher validiert werden." % int(slot))
    src = info["path"]
    dst = "/boot/STARTUP_ONCE"
    tmp = dst + ".safeupdate-new"
    with open(src, "rb") as fsrc, open(tmp, "wb") as fdst:
        shutil.copyfileobj(fsrc, fdst)
        fdst.flush()
        os.fsync(fdst.fileno())
    os.replace(tmp, dst)
    subprocess.call(["sync"])

def restore(plan, state, source, backup, expected_hash, auto=False, reboot_after=False):
    cur = current_slot()
    if cur != backup:
        die("Wiederherstellung ist nur erlaubt, während Sicherheits-Slot %d läuft." % backup)
    if cur == source:
        die("Der laufende Slot wird niemals über sich selbst überschrieben.")

    src_info = parse_startup(backup)
    dst_info = parse_startup(source)
    if not src_info or not dst_info:
        die("STARTUP-Zuordnung konnte nicht eindeutig geprüft werden.")
    if src_info["rootdev"] != dst_info["rootdev"]:
        die("Quelle und Ziel liegen nicht auf demselben verifizierten Multiboot-Dateisystem.")
    if not src_info["kernel_in_tree"] or not dst_info["kernel_in_tree"]:
        die("Separate Kernelpartition erkannt. r34-dev2 überschreibt diese NICHT.")

    bad = fs_error_seen(src_info["rootdev"])
    if bad:
        if plan:
            plan["phase"] = "blocked_fs_error"
            plan["error"] = bad
            plan["updated"] = int(time.time())
            write_json_atomic(PLAN_FILE, plan)
        die("Dateisystem meldet einen Kernel-/Journalfehler. Automatische Wiederherstellung bleibt gesperrt: %s" % bad)

    mp = mount_root(src_info["rootdev"])
    try:
        backup_dir = os.path.join(mp, src_info["rootsubdir"])
        target_dir = os.path.join(mp, dst_info["rootsubdir"])
        new_dir = target_dir + NEW_SUFFIX
        old_dir = target_dir + OLD_SUFFIX

        base_real = os.path.realpath(mp).rstrip("/") + "/"
        for p in (backup_dir, target_dir, new_dir, old_dir):
            if not os.path.realpath(p).startswith(base_real):
                die("Unsicherer Recovery-Pfad erkannt.")
        if os.path.basename(backup_dir) != "linuxrootfs%d" % backup:
            die("Backup-Pfad stimmt nicht mit Sicherheits-Slot überein.")
        if os.path.basename(target_dir) != "linuxrootfs%d" % source:
            die("Zielpfad stimmt nicht mit Quellslot überein.")
        if os.path.lexists(new_dir) or os.path.lexists(old_dir):
            die("Alter Recovery-Rest gefunden. Es wird nichts automatisch gelöscht.")
        if not valid_tree(backup_dir, expected_hash):
            die("Sicherheits-Slot besteht die physische Verifikation nicht.")

        need = tree_size(backup_dir) + RESERVE_BYTES
        free = shutil.disk_usage(mp).free
        if free < need:
            die("Nicht genug freier Speicher für sichere Doppelkopie. Benötigt zusätzlich ca. %.1f GiB." % (need / 1073741824.0))

        print("[OK] Sicherheits-Slot %d physisch verifiziert." % backup)
        print("[OK] Ziel Slot %d ist inaktiv." % source)
        print("[OK] Dateisystem zeigt aktuell keinen EXT4-/Journalfehler.")
        print("[OK] Genug Platz für sichere Doppelkopie.")

        if not auto:
            ans = input("\nSlot %d aus Sicherheits-Slot %d wiederherstellen? [JA/nein]: " % (source, backup)).strip().upper()
            if ans != "JA":
                print("Abgebrochen. Nichts verändert.")
                return 0

        if plan:
            plan["phase"] = "restoring"
            plan["updated"] = int(time.time())
            write_json_atomic(PLAN_FILE, plan)

        os.mkdir(new_dir)
        print("\n[1/4] Sicherheitsbackup wird kopiert ...")
        subprocess.check_call(["cp", "-a", backup_dir + "/.", new_dir + "/"])
        subprocess.check_call(["sync"])
        if not valid_tree(new_dir, expected_hash):
            die("Neue Kopie konnte nicht verifiziert werden. Alter Slot bleibt unangetastet.")

        print("[2/4] Neue Kopie verifiziert.")
        had_old = os.path.lexists(target_dir)
        if had_old:
            if not os.path.isdir(target_dir) or os.path.islink(target_dir):
                die("Bestehender Zielslot ist kein normales Verzeichnis.")
            os.rename(target_dir, old_dir)

        try:
            os.rename(new_dir, target_dir)
            subprocess.check_call(["sync"])
            if not valid_tree(target_dir, expected_hash):
                raise RuntimeError("final verification failed")
        except Exception:
            if os.path.lexists(target_dir):
                try:
                    os.rename(target_dir, new_dir)
                except Exception:
                    pass
            if had_old and os.path.lexists(old_dir) and not os.path.lexists(target_dir):
                os.rename(old_dir, target_dir)
            subprocess.call(["sync"])
            if plan:
                plan["phase"] = "restore_failed"
                plan["updated"] = int(time.time())
                write_json_atomic(PLAN_FILE, plan)
            die("Finale Prüfung fehlgeschlagen. Vorheriger Slot wurde soweit möglich zurückgesetzt.")

        print("[3/4] Slot %d final verifiziert." % source)
        if had_old and os.path.isdir(old_dir) and not os.path.islink(old_dir):
            shutil.rmtree(old_dir)
            subprocess.check_call(["sync"])
        print("[4/4] Alter fehlerhafter Slot-Inhalt entfernt.")

        set_startup_once(source)
        if plan:
            plan["phase"] = "restored"
            plan["updated"] = int(time.time())
            write_json_atomic(PLAN_FILE, plan)

        print("\n" + "=" * 62)
        print(" WIEDERHERSTELLUNG ERFOLGREICH")
        print("=" * 62)
        print("Slot %d wurde aus Sicherheits-Slot %d wiederhergestellt." % (source, backup))
        print("Sicherheits-Slot %d wurde NICHT verändert." % backup)
        print("Der nächste Start ist einmalig auf Slot %d gesetzt." % source)

        if reboot_after:
            print("Box wird neu gestartet ...")
            subprocess.call(["sync"])
            time.sleep(2)
            subprocess.call(["reboot"])
        return 0
    finally:
        unmount_root()

def main():
    headline()
    plan, state, source, backup, expected_hash = relation_or_die()
    cur = current_slot()
    print("Aktiver Slot:       %s" % ("nicht erkannt" if cur is None else cur))
    print("Ursprünglicher Slot:%s" % (" %d" % source))
    print("Sicherheits-Slot:   %d" % backup)
    if plan:
        print("Recovery-Phase:     %s" % plan.get("phase", "unbekannt"))
    print()

    if cur is None:
        die("Aktiver Slot konnte nicht sicher aus /proc/cmdline bestimmt werden.")

    if "--restore-auto-reboot" in sys.argv:
        if not plan or plan.get("phase") not in ("fallback", "restore_failed"):
            die("Automatische GUI-Wiederherstellung ist nicht freigegeben.")
        return restore(plan, state, source, backup, expected_hash, auto=True, reboot_after=True)

    if cur == source:
        print("System läuft im ursprünglichen Slot %d." % source)
        print("Keine manuelle Aktion nötig. r34-dev2 übernimmt den Recovery-Pfad nach einem Update automatisch.")
        return 0

    if cur != backup:
        die("Aktiver Slot %d ist weder Quellslot %d noch Sicherheits-Slot %d." % (cur, source, backup))

    print("Sicherheits-Slot läuft. Der defekte Slot kann gefahrlos ersetzt werden.")
    return restore(plan, state, source, backup, expected_hash, auto=False, reboot_after=False)

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nAbgebrochen. Nichts weiter ausgeführt.")
        raise SystemExit(130)
