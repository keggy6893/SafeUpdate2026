#!/usr/bin/env python3
# SafeUpdate2026 r34-dev1 recovery helper
# Runs outside Enigma2. Standard library only.

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

STATE_FILE = "/etc/enigma2/safeupdate2026.json"
MOUNTPOINT = "/tmp/safeupdate2026-recovery-root"
NEW_SUFFIX = ".safeupdate-restore-new"
OLD_SUFFIX = ".safeupdate-broken-old"
RESERVE_BYTES = 128 * 1024 * 1024

def die(msg, code=2):
    print("\n[BLOCKIERT] %s" % msg)
    raise SystemExit(code)

def read_text(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    except Exception:
        return ""

def load_state():
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}

def cmd_value(key):
    cmd = read_text("/proc/cmdline")
    m = re.search(r"(?:^|\s)%s=([^\s]+)" % re.escape(key), cmd)
    return m.group(1).strip("'\"") if m else ""

def current_slot():
    sub = cmd_value("rootsubdir")
    m = re.search(r"(?:^|/)linuxrootfs(\d+)$", sub)
    if m:
        return int(m.group(1))
    kern = cmd_value("kernel")
    m = re.search(r"(?:^|/)linuxrootfs(\d+)/zImage$", kern)
    return int(m.group(1)) if m else None

def resolve_root_spec(spec):
    spec = (spec or "").strip()
    if spec.startswith("/dev/"):
        return os.path.realpath(spec)
    maps = {
        "UUID=": "/dev/disk/by-uuid/",
        "PARTUUID=": "/dev/disk/by-partuuid/",
        "LABEL=": "/dev/disk/by-label/",
        "PARTLABEL=": "/dev/disk/by-partlabel/",
    }
    for prefix, base in maps.items():
        if spec.startswith(prefix):
            p = os.path.join(base, spec[len(prefix):])
            if os.path.exists(p):
                return os.path.realpath(p)
    try:
        out = subprocess.check_output(["blkid", "-t", spec, "-o", "device"], stderr=subprocess.DEVNULL, text=True).strip().splitlines()
        if out:
            return os.path.realpath(out[0])
    except Exception:
        pass
    return ""

def parse_startup(slot):
    path = "/boot/STARTUP_%d" % int(slot)
    if not os.path.isfile(path) or os.path.islink(path):
        return None
    text = read_text(path)
    def grab(key):
        m = re.search(r"(?:^|[\s'\"])%s=([^\s'\"]+)" % key, text)
        return m.group(1) if m else ""
    root = grab("root")
    rootsubdir = grab("rootsubdir")
    kernel = grab("kernel")
    if rootsubdir != "linuxrootfs%d" % int(slot):
        return None
    rootdev = resolve_root_spec(root)
    if not rootdev:
        return None
    normkernel = os.path.normpath(kernel.lstrip("/"))
    expected_kernel = "linuxrootfs%d/zImage" % int(slot)
    return {
        "slot": int(slot), "path": path, "root": root, "rootdev": rootdev,
        "rootsubdir": rootsubdir, "kernel": kernel,
        "kernel_in_tree": normkernel == expected_kernel,
    }

def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            b = f.read(1024 * 1024)
            if not b:
                break
            h.update(b)
    return h.hexdigest()

def tree_size(path):
    total = 0
    for root, dirs, files in os.walk(path, followlinks=False):
        for name in files:
            p = os.path.join(root, name)
            try:
                if not os.path.islink(p):
                    total += os.lstat(p).st_size
            except OSError:
                pass
    return total

def valid_tree(path, expected_hash=""):
    if not os.path.isdir(path) or os.path.islink(path):
        return False
    required = [
        os.path.join(path, "etc", "image-version"),
        os.path.join(path, "sbin", "init"),
        os.path.join(path, "usr", "bin", "enigma2"),
        os.path.join(path, "zImage"),
    ]
    if not all(os.path.exists(p) for p in required):
        return False
    if expected_hash:
        try:
            if sha256(os.path.join(path, "zImage")) != expected_hash:
                return False
        except Exception:
            return False
    return True

def enigma2_running():
    try:
        return subprocess.call(["pidof", "enigma2"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0
    except Exception:
        return False

def mount_root(dev):
    os.makedirs(MOUNTPOINT, exist_ok=True)
    # Never reuse a mountpoint containing unrelated data.
    if os.path.ismount(MOUNTPOINT):
        subprocess.check_call(["umount", MOUNTPOINT])
    subprocess.check_call(["mount", "-o", "rw", dev, MOUNTPOINT])
    return MOUNTPOINT

def unmount_root():
    try:
        if os.path.ismount(MOUNTPOINT):
            subprocess.check_call(["sync"])
            subprocess.call(["umount", MOUNTPOINT])
    except Exception:
        pass

def headline():
    print("=" * 62)
    print("              SAFE UPDATE 2026 - RECOVERY")
    print("                    r34-dev1 TEST")
    print("=" * 62)

def state_or_die():
    st = load_state()
    if not st.get("verified"):
        die("Kein verifiziertes SafeUpdate-Backup in %s." % STATE_FILE)
    if st.get("backup_mode", "slot") != "slot":
        die("Dieser Telnet-Test ist nur für bootbare Slot-Backups. Internes eMMC nutzt den bestehenden Notfall-Restore.")
    try:
        source = int(st["source_slot"])
        backup = int(st["target_slot"])
    except Exception:
        die("Backup-Zuordnung source_slot/target_slot fehlt.")
    if source <= 0 or backup <= 0 or source == backup:
        die("Ungültige Slot-Zuordnung.")
    return st, source, backup

def show_status(st, source, backup, cur):
    print("Aktiver Slot:       %s" % ("nicht erkannt" if cur is None else cur))
    print("Defekter Quellslot: %d" % source)
    print("Sicherheits-Slot:   %d" % backup)
    print("Backup erstellt:    %s" % st.get("created", "unbekannt"))
    print("Backup verifiziert: JA")
    print()

def restore(st, source, backup, cur):
    if cur != backup:
        die("Wiederherstellung nur erlaubt, wenn der Sicherheits-Slot %d gerade läuft." % backup)
    if cur == source:
        die("Der laufende Slot wird niemals über sich selbst überschrieben.")
    if enigma2_running():
        die("Enigma2 läuft noch. Zuerst 'init 4' ausführen und safeupdate-recover erneut starten.")

    src_info = parse_startup(backup)
    dst_info = parse_startup(source)
    if not src_info or not dst_info:
        die("STARTUP-Zuordnung konnte nicht eindeutig geprüft werden.")
    if src_info["rootdev"] != dst_info["rootdev"]:
        die("Quelle und Ziel liegen nicht auf demselben verifizierten Multiboot-Dateisystem.")
    if not src_info["kernel_in_tree"] or not dst_info["kernel_in_tree"]:
        die("Separate Kernelpartition erkannt. r34-dev1 überschreibt diese NICHT.")

    expected_hash = str(st.get("kernel_sha256") or "")
    mp = mount_root(src_info["rootdev"])
    try:
        backup_dir = os.path.join(mp, src_info["rootsubdir"])
        target_dir = os.path.join(mp, dst_info["rootsubdir"])
        new_dir = target_dir + NEW_SUFFIX
        old_dir = target_dir + OLD_SUFFIX

        base_real = os.path.realpath(mp).rstrip("/") + "/"
        for p in (backup_dir, target_dir, new_dir, old_dir):
            if not os.path.realpath(p).startswith(base_real):
                die("Unsicherer Recovery-Pfad erkannt.")
        if os.path.basename(backup_dir) != "linuxrootfs%d" % backup:
            die("Backup-Pfad stimmt nicht mit Sicherheits-Slot überein.")
        if os.path.basename(target_dir) != "linuxrootfs%d" % source:
            die("Zielpfad stimmt nicht mit Quellslot überein.")
        if os.path.lexists(new_dir) or os.path.lexists(old_dir):
            die("Alter Recovery-Rest gefunden. Es wird nichts automatisch gelöscht.")
        if not valid_tree(backup_dir, expected_hash):
            die("Sicherheits-Slot besteht die physische Verifikation nicht.")

        need = tree_size(backup_dir) + RESERVE_BYTES
        free = shutil.disk_usage(mp).free
        if free < need:
            die("Nicht genug freier Speicher für sichere Doppelkopie. Benötigt zusätzlich ca. %.1f GiB." % (need / 1073741824.0))

        print("[OK] Sicherheits-Slot %d physisch verifiziert." % backup)
        print("[OK] Ziel Slot %d ist NICHT der laufende Slot." % source)
        print("[OK] Genug Platz für sichere Doppelkopie.")
        print()
        print("Slot %d  ======>  Slot %d" % (backup, source))
        print("Der Sicherheits-Slot %d bleibt unverändert." % backup)
        print("Der aktuelle Inhalt von Slot %d wird erst NACH Prüfung ersetzt." % source)
        ans = input("\nWiederherstellung wirklich starten? [JA/nein]: ").strip().upper()
        if ans != "JA":
            print("Abgebrochen. Nichts verändert.")
            return 0

        os.mkdir(new_dir)
        print("\n[1/4] Kopiere verifiziertes Backup in temporären Zielbaum ...")
        subprocess.check_call(["cp", "-a", backup_dir + "/.", new_dir + "/"])
        subprocess.check_call(["sync"])
        if not valid_tree(new_dir, expected_hash):
            die("Neue Kopie konnte nicht verifiziert werden. Alter Slot bleibt unangetastet.")

        print("[2/4] Neue Kopie verifiziert.")
        had_old = os.path.lexists(target_dir)
        if had_old:
            if not os.path.isdir(target_dir) or os.path.islink(target_dir):
                die("Bestehender Zielslot ist kein normales Verzeichnis.")
            os.rename(target_dir, old_dir)
        try:
            os.rename(new_dir, target_dir)
            subprocess.check_call(["sync"])
            if not valid_tree(target_dir, expected_hash):
                raise RuntimeError("final verification failed")
        except Exception:
            if os.path.lexists(target_dir):
                try:
                    os.rename(target_dir, new_dir)
                except Exception:
                    pass
            if had_old and os.path.lexists(old_dir) and not os.path.lexists(target_dir):
                os.rename(old_dir, target_dir)
            subprocess.call(["sync"])
            die("Finale Prüfung fehlgeschlagen. Vorheriger Slot wurde soweit möglich zurückgesetzt.")

        print("[3/4] Slot %d final verifiziert." % source)
        if had_old and os.path.isdir(old_dir) and not os.path.islink(old_dir):
            shutil.rmtree(old_dir)
            subprocess.check_call(["sync"])
        print("[4/4] Alter fehlerhafter Slot-Inhalt entfernt.")
        print("\n" + "=" * 62)
        print(" WIEDERHERSTELLUNG ERFOLGREICH")
        print("=" * 62)
        print("Slot %d wurde aus Sicherheits-Slot %d wiederhergestellt." % (source, backup))
        print("Sicherheits-Slot %d wurde NICHT verändert." % backup)
        print("Jetzt im Multiboot-Menü wieder Slot %d starten." % source)
        return 0
    finally:
        unmount_root()

def main():
    headline()
    st, source, backup = state_or_die()
    cur = current_slot()
    show_status(st, source, backup, cur)

    if cur is None:
        die("Aktiver Slot konnte nicht sicher aus /proc/cmdline bestimmt werden.")

    if cur == source:
        print("Du bist noch im ursprünglichen Slot %d." % source)
        print("Dieser Slot wird NICHT im laufenden Betrieb überschrieben.")
        print()
        print("Nächster Schritt:")
        print("  1. Box neu starten")
        print("  2. Im Multiboot-Menü Sicherheits-Slot %d wählen" % backup)
        print("  3. Dort per Telnet: init 4")
        print("  4. Danach: safeupdate-recover")
        return 0

    if cur != backup:
        die("Aktiver Slot %d ist weder Quellslot %d noch Sicherheits-Slot %d." % (cur, source, backup))

    print("[OK] Sicherheits-Slot läuft.")
    print("Wiederherstellung von Slot %d ist jetzt sicher möglich." % source)
    return restore(st, source, backup, cur)

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nAbgebrochen. Nichts weiter ausgeführt.")
        raise SystemExit(130)
